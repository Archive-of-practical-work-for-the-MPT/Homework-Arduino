<Window x:Class="Sound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sound"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="#1c1c1c"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Name="lbl" Grid.Row="0" Width="300" Height="100" BorderBrush="LimeGreen" BorderThickness="1" Grid.ColumnSpan="2" Content="С++ &lt; Python" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="24px"></Label>
        <ComboBox Name="CmbBx" Grid.Row="1" Width="300" FontSize="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.ColumnSpan="2" Height="100" BorderBrush="LimeGreen" BorderThickness="1">
            <ComboBoxItem Content="0.1 sec"/>
            <ComboBoxItem Content="0.5 sec"/>
            <ComboBoxItem Content="1 sec"/>
        </ComboBox>
        <Button Grid.Row="2" Margin="20" Content="Жестко мигаем" Height="100" FontSize="30" x:Name="button1" Click="button1_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Margin="20" Content="Жестко звучим" Height="100" FontSize="30" x:Name="button2" Click="button2_Click"/>
    </Grid>
</Window>
